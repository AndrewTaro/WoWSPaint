




(def constant WoWSPaint_ERASER_COLOR "-1")
(def constant WoWSPaint_PALETTE_COLUMN_COUNT "4")
(def constant WoWSPaint_PALETTE_SIZE "28px")
(def constant WoWSPaint_PALETTE_GAP "3px")
(def constant WoWSPaint_POSITION_KEY 'ttaro.wowsPaint.position')


(def constant WoWSPaint_COMPONENT_KEY 'modWoWSPaint')
(def constant WoWSPaint_MODE_2D "0")
(def constant WoWSPaint_MODE_3D "1")

(def element WorldOfWarshipsPaint() layout=true
	(scope
		(macro STAGE_SIZE)
		(event evStageMouseMove)
		(event evMouseDown)
		(event evMouseMove)
		(event evMouseUp)
		(event evMouseActive)
		(event evMouseInactive)
		(event evStartDraw)
		(event evStopDraw)
		(event evClearDraw)
		(event evChangeColor)
		(event evClearButtonClick)
		(event evCheckMouseBeforeClear)
		(event evModeChange)

		(var worldWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, WoWSPaint_COMPONENT_KEY)")
		(var worldEntity:gfx = "worldWatcher.entity" (event "worldWatcher.event"))
		(var is3DAvailable:bool = "worldEntity ? true : false")
		(macro TT_GET_PREF _varName="'modePref'" _key="'ttaro.wowsPaint.canvasMode'")
		(var canvasMode:number = "null != modePref && null != modePref.value ? modePref.value : WoWSPaint_MODE_2D")

		(var is3D:bool = "is3DAvailable && canvasMode == WoWSPaint_MODE_3D")

		(var mouse:gfx = "$datahub.getSingleComponent(CC.mouse)")
		(var isMouseActive:bool = "mouse.active" (event "mouse.evActiveChanged"))

		(var playerAvatar:gfx = "$datahub.getSingleComponent(CC.playerAvatar)")
		(var isPlayer:bool = "playerAvatar")

		(var isDrawing:bool = "false" watch=false)
		(bind isDrawing "$event.isDrawing" watch=false init=false (event "evStartDraw") (event "evStopDraw"))




		(macro TT_GET_PREF _varName="'color1'" _key="'ttaro.wowsPaint.palette.color1'")
		(macro TT_GET_PREF _varName="'color2'" _key="'ttaro.wowsPaint.palette.color2'")
		(macro TT_GET_PREF _varName="'color3'" _key="'ttaro.wowsPaint.palette.color3'")
		(macro TT_GET_PREF _varName="'color4'" _key="'ttaro.wowsPaint.palette.color4'")
		(macro TT_GET_PREF _varName="'color5'" _key="'ttaro.wowsPaint.palette.color5'")
		(macro TT_GET_PREF _varName="'color6'" _key="'ttaro.wowsPaint.palette.color6'")
		(macro TT_GET_PREF _varName="'color7'" _key="'ttaro.wowsPaint.palette.color7'")















		(var palette:array = "[
			WoWSPaint_ERASER_COLOR,
			null != color1 && null != color1.value ? color1.value : 0xFFFF0000,
			null != color2 && null != color2.value ? color2.value : 0xFF00FF00,
			null != color3 && null != color3.value ? color3.value : 0xFF0000FF,
			null != color4 && null != color4.value ? color4.value : 0xFFFFFFFF,
			null != color5 && null != color5.value ? color5.value : 0xFFFF6600,
			null != color6 && null != color6.value ? color6.value : 0xFF4CE8AA,
			null != color7 && null != color7.value ? color7.value : 0xFF13C9F7
		]")
		(var paletteAlpha:array = "[
			1.0,
			null != color1 && null != color1.a ? color1.a : 1.0,
			null != color2 && null != color2.a ? color2.a : 1.0,
			null != color3 && null != color3.a ? color3.a : 1.0,
			null != color4 && null != color4.a ? color4.a : 1.0,
			null != color5 && null != color5.a ? color5.a : 1.0,
			null != color6 && null != color6.a ? color6.a : 1.0,
			null != color7 && null != color7.a ? color7.a : 1.0
		]")



		(macro TT_GET_PREF _varName="'brushIndexPref'" _key="'ttaro.wowsPaint.selectedBrush'")
		(var brushColorIndex:number = "null != brushIndexPref && null != brushIndexPref.value ? round(brushIndexPref.value) : 0" watch=false)
		(bind brushColorIndex "$event.colorIndex" watch=false init=false (event "evChangeColor"))
		(var brushColor:number = "brushColorIndex < palette.length ? palette[brushColorIndex] : palette[0]")
		(var brushAlpha:number = "brushColorIndex < paletteAlpha.length ? paletteAlpha[brushColorIndex] : paletteAlpha[0]")

		(var isEraser:bool = "brushColor == WoWSPaint_ERASER_COLOR")
		(var brushSize:number = "isEraser ? 50 : 3")
	)

	(style
		(bind height "stageHeight")
		(bind width "stageWidth")
	)

	(bindcall externalCall 'direct.action' "['mod.setPref', ['ttaro.wowsPaint.selectedBrush', $event.colorIndex]]" init=false watch=false (event "evChangeColor"))
	(bindcall externalCall 'direct.action' "['mod.setPref', ['ttaro.wowsPaint.canvasMode', $event.mode]]" init=false watch=false (event "evModeChange"))

	(bindcall externalCall 'direct.action' "['wowsPaint.clear', []]" init=false watch=false (bind enabled "is3DAvailable") (event "evClearButtonClick"))

	(dispatch evMouseActive args="{}" (bind enabled "isMouseActive")  (bind trigger "isMouseActive"))
	(dispatch evMouseInactive args="{}" (bind enabled "!isMouseActive") (bind trigger "isMouseActive"))
	(dispatch evStartDraw dir="EventDirection.DOWN" args="{isDrawing:true, x: $event.x, y: $event.y}" (bind enabled "!is3D") (event "evMouseDown"))
	(dispatch evStopDraw dir="EventDirection.DOWN" args="{isDrawing:false}" (event "evMouseUp") (event "evMouseInactive"))
	(dispatch evClearDraw dir="EventDirection.DOWN" args="{}" (event "evClearButtonClick"))
	(dispatch evCheckMouseBeforeClear args="{}" delay=2 (bind enabled "isPlayer") (event "evMouseInactive"))
	(dispatch evClearDraw args="{}" dir="EventDirection.DOWN" (bind enabled "!isMouseActive") (event "evCheckMouseBeforeClear"))


	(block
		(style
			(width = "100%")
	 		(height = "100%")
	 		(position = "absolute")


		)


		(dispatch evMouseDown args="{x: $event.stageX, y: $event.stageY}" on='stageMouseDown')
		(dispatch evMouseUp dir="EventDirection.DOWN"  args="{}" on='stageMouseUp')


		(dispatch evMouseMove dir="EventDirection.DOWN" args="$event ? {x: $event.stageX, y: $event.stageY} : null" on='stageMouseMove' (bind enabled "isDrawing"))

		(controller $Repeat renderer='WoWSPaint_LayerElement'



			(args
				_currentColor="brushColor"
				_currentAlpha="brushAlpha"
			)
			(bindcall addChildAt "0" watch=false init=false (event "evStartDraw"))
		)
		(bindcall removeChildren watch=false init=false  (event "evClearDraw"))
		(blendMode = 'layer')
	)

	(element WoWSPaint_ControlElement _currentColor="brushColor" _palette="palette" _is3DAvailable="is3DAvailable" _canvasMode="canvasMode")





	(controller $Tooltip (renderer = 'WoWSPaint_BrushElement')
		(args _currentColor="brushColor" _currentAlpha="brushAlpha" _size="brushSize" _isVisible="!is3D")
		(position="trackMouse")
		(offset=[0,0])
		(screenBoundsOffset={left:-100, top:-100, right:-100, bottom:-100})
		(bindcall show animation={duration:0.15, from:{alpha:0}, to:{alpha:1}} (event "evMouseActive"))
		(bindcall hide animation={duration:0.15, from:{alpha:1}, to:{alpha:0}} (event "evMouseInactive"))
	)
)

(def element WoWSPaint_BrushElement(_currentColor:number, _currentAlpha:number, _size:number, _isVisible:bool=true)
	(scope
		(var isSmall:bool = "_size < 5 ? true : false")
	)

	(bind visible "_isVisible")

	(style
		(hitTest = false)
	)



	(controller $Sector
		(bind arc "360")
		(bind radius "isSmall ? _size : _size / 2")
		(bind lineColor "_currentColor")
		(bind lineThickness "isSmall ? 2 : 1")
		(bind lineAlpha "(isSmall ? 1.0 : 0.4) * _currentAlpha")
	)
	(cacheAsBitmap=true)
)

(def element WoWSPaint_LayerElement(_currentColor:number, _currentAlpha:number)
	(scope
		(event evStartDraw)
		(event evClearDraw)
		(event evMouseMove)
		(event evMouseUp)

		(var stage:gfx = "$datahub.getSingleComponent(CC.stage)")
		(var scale:number = "stage.scale" (event "stage.evStageSizeChanged"))



		(var isEraser:bool = "_currentColor == WoWSPaint_ERASER_COLOR" watch=false)
		(var brushSize:number = "isEraser ? 50 : 3")



		(var isActiveLayer:bool = "true" watch=false)
		(bind isActiveLayer "false" init=false (event "evMouseUp"))
	)

	(style
		(width = "100%")
		(height = "100%")
		(hitTest = false)
		(position = "absolute")








		(alpha = "_currentAlpha")
	)

	(.graphics





		(bindcall lineStyle "brushSize" "_currentColor" "1" watch=false init=false (bind enabled "isActiveLayer") (event "evStartDraw"))
		(bindcall moveTo "round($event.x / scale)" "round($event.y / scale)" watch=false init=false (bind enabled "isActiveLayer") (event "evStartDraw"))
		(bindcall lineTo "round($event.x / scale)" "round($event.y / scale)" watch=false init=false (bind enabled "isActiveLayer") (event "evMouseMove"))
		(bindcall clear watch=false init=false (event "evClearDraw"))
	)
	(blendMode = "isEraser ? 'subtract' : 'layer'")

)

(def element WoWSPaint_ControlElement(_currentColor:number, _palette:array, _is3DAvailable:bool=false, _canvasMode:number=0)
	(scope
		(var mouse:gfx = "$datahub.getSingleComponent(CC.mouse)")
		(var isMouseActive:bool = "mouse.active" (event "mouse.evActiveChanged"))



		(macro TT_DRAGGABLE_POSITION _fullKey="WoWSPaint_POSITION_KEY")
		(macro TT_GET_PREF _varName="'lockPref'" _key="'ttaro.wowsPaint.disableDragDrop'")
		(var isPositionLocked:bool = "null != lockPref && null != lockPref.value ? lockPref.value : false")

		(var camera:gfx = "$datahub.getSingleComponent(CC.camera)")
		(var altVision:bool = "null != camera ? camera.altVision : false" (event "camera.evAltVisionChanged"))

		(event evExpandButtonClick)
		(macro TT_GET_PREF _varName="'paletteModePref'" _key="'ttaro.wowsPaint.palette.displayMode'")
		(var paletteMode:number = "null != paletteModePref && null != paletteModePref.value ? paletteModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")
		(var isPaletteVisible:bool = "paletteMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : paletteMode")
	)



	(bindcall externalCall 'direct.action' "['mod.setPref', ['ttaro.wowsPaint.palette.displayMode', $event.value ? TT_CONST.DISPLAY_MODE.ENABLED : TT_CONST.DISPLAY_MODE.DISABLED]]" init=false watch=false (event "evExpandButtonClick"))

	(style
		(position = "absolute")
		(bind left "dragX")
		(bind top "dragY")
		(alpha = "isMouseActive ? 1.0 : 0.3")
	)

	(controller $Animation
		(bindcall play
			to	="{alpha: 0.3}"
			duration=0.15
			(bind enabled "!isMouseActive")
			(bind trigger "isMouseActive")
		)
		(bindcall play
			to	="{alpha: 1.0}"
			duration=0.15
			(bind enabled "isMouseActive")
			(bind trigger "isMouseActive")
		)
	)

	(block




		(block
			(class $FullsizeAbsolute)




			(style
				(backgroundColor = 0x00FFFFFF)
				(bind hitTest "!isPositionLocked")
			)
			(macro TT_DRAGGABLE _fullKey="WoWSPaint_POSITION_KEY" _isDragEnabled="!isPositionLocked")
		)
		(block
			(style
				(hitTest = true)
				(align = "middle|center")
				(padding = 10px)
			)


			(block
				(controller $Instance renderer='WoWSPaint_ModeSwitchElement'
					(bind enabled "_is3DAvailable")
					(args _canvasMode="_canvasMode")
				)
			)


			(element WoWSPaint_ResetButtonElement)


			(block
				(controller $Instance renderer='WoWSPaint_ColorPaletteElement'
					(bind enabled "isPaletteVisible")
					(args _currentColor="_currentColor" _palette="_palette")
				)
			)
		)

		(element WoWSPaint_ExpandButtonElement _isPaletteVisible="isPaletteVisible"
			(style
				(position = "absolute")
				(left = -28px)
				(top = 5px)
			)
		)
	)
)

(def element WoWSPaint_ModeSwitchElement(_canvasMode:number)
	(style
		(flow = "Flow.HORIZONTAL")
		(hgap = 8px)
		(align = "middle|center")
		(marginBottom = 10px)
	)
	(element WoWSPaint_ModeTabElement _label="'2D'" _mode="WoWSPaint_MODE_2D" _canvasMode="_canvasMode")
	(element WoWSPaint_ModeTabElement _label="'3D'" _mode="WoWSPaint_MODE_3D" _canvasMode="_canvasMode")
)

(def element WoWSPaint_ModeTabElement(_label:str, _mode:number, _canvasMode:number)
	(scope
		(event evModeChange)
		(macro MOUSE_HANDLER_SCOPE)

		(var isSelected:bool = "_mode == _canvasMode")
		(var isRollover:bool = "rollOver")
	)

	(style
		(hitTest = true)
	)

	(tf
		(class $TextDefaultBoldNM)
		(bind text "_label")
		(style
			(hitTest = false)
		)
	)

	(bind alpha "isSelected ? 1.0 : isRollover ? 0.8 : 0.4")

	(dispatch evModeChange on='click' args="{mode: _mode}" dir="EventDirection.UP")
	(macro MOUSE_HANDLER
		_soundSet = "'button_tab'"
	)
)

(def element WoWSPaint_ExpandButtonElement(_isPaletteVisible:bool)
	(scope
		(event evExpandButtonClick)
		(macro MOUSE_HANDLER_SCOPE)

		(var isDown:bool = "mouseDown")
		(var isRollover:bool = "rollOver")

		(var ctRollOver:dict = "{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: 15,	greenOffset: 15,	blueOffset: 15,		alphaOffset: 0 }")
		(var ctDown:dict = "	{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: -15,	greenOffset: -15,	blueOffset: -15,	alphaOffset: 0 }")



		(var targetRotation:number = "_isPaletteVisible ? 90 : 0")
	)

	(block
		(style
			(width = 18)
			(height = 18)
			(align = "middle|center")
			(marginTop = -2px)
		)
		(block
			(style
				(backgroundSize = "autosize")
				(backgroundImage = "'url:../service_kit/buttons/expand_over.png'")
				(pivotX = 50%)
				(pivotY = 50%)
				(rotation = "targetRotation")
			)
			(controller $Animation
				(bindcall play	duration=0.15	to="{rotation: targetRotation}"	(bind trigger "targetRotation"))
			)
		)



		(dispatch evExpandButtonClick dir="EventDirection.UP" args="{value: !_isPaletteVisible}" on='click')

		(macro MOUSE_HANDLER
			_soundSet = "'button_tab'"
		)

		(bind colorTransform "	isRollover && !isDown	? ctRollOver :
								isDown					? ctDown
														: CT_NONE")
	)
)

(def element WoWSPaint_ResetButtonElement()
	(scope
		(event evClearButtonClick)
		(macro MOUSE_HANDLER_SCOPE)

		(var isDown:bool = "mouseDown")
		(var isRollover:bool = "rollOver")

		(var ctRollOver:dict = "{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: 15,	greenOffset: 15,	blueOffset: 15,		alphaOffset: 0 }")
		(var ctDown:dict = "	{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: -15,	greenOffset: -15,	blueOffset: -15,	alphaOffset: 0 }")
	)

	(hblock
		(style
			(align = "middle|center")
		)
		(tf
			(text = "'CLEAR CANVAS'")
			(class $TextDefaultBoldNM)
			(style
				(marginRight = 5px)
				(leading = -6)
			)
		)
		(block
			(style
				(width = 18)
				(height = 18)
				(backgroundImage = "'url:../service_kit/buttons/context/update.png'")
			)
		)

		(bind colorTransform "	isRollover && !isDown	? ctRollOver :
								isDown					? ctDown
														: CT_NONE")

		(dispatch evClearButtonClick on='click' args="{}" dir="EventDirection.UP")
		(macro MOUSE_HANDLER
			_soundSet = "'button_tab'"
		)
	)
)

(def element WoWSPaint_ColorPaletteElement(_currentColor:number, _palette:array)
	(style
		(marginTop = 10px)
		(gap = "WoWSPaint_PALETTE_GAP")
	)
	(controller $Repeat renderer='WoWSPaint_ColorPaletteRowElement' count="ceil(_palette.length / WoWSPaint_PALETTE_COLUMN_COUNT)"
		(args
			_currentColor="_currentColor"
			_palette="_palette"
		)
	)
)

(def element WoWSPaint_ColorPaletteRowElement(_currentColor:number, _palette:array)
	(scope
		(var colorIndexOffset:number = "$index * WoWSPaint_PALETTE_COLUMN_COUNT")
	)

	(style
		(hgap = "WoWSPaint_PALETTE_GAP")
		(flow = "Flow.HORIZONTAL")
	)

	(controller $Repeat renderer='WoWSPaint_ColorTileElement' count="WoWSPaint_PALETTE_COLUMN_COUNT"
		(args
			_index="colorIndexOffset + $index"
			_currentColor="_currentColor"
			_palette="_palette"
		)
	)
)

(def element WoWSPaint_ColorTileElement(_index:number, _currentColor:number, _palette:array)
	(scope
		(event evChangeColor)
		(var colorIndex:number = "_index")
		(var colorValue:number = "_palette[colorIndex]")
		(var isValidColor:number = "colorIndex < _palette.length")
		(var isSelected:bool = "colorValue == _currentColor")

		(var isEraser:bool = "colorValue == WoWSPaint_ERASER_COLOR")

		(var palettePos:number = "WoWSPaint_PALETTE_SIZE / 2")

		(macro MOUSE_HANDLER_SCOPE)
	)

	(bind visible "isValidColor")
	
	(block
		(style
			(width  = "WoWSPaint_PALETTE_SIZE")
			(height = "WoWSPaint_PALETTE_SIZE")
		)
		(block
			(style
				(position = "absolute")
				(width = 100%)
				(height = 100%)
				(left = "palettePos")
				(top = "palettePos")
				(pivotX = 50%)
				(pivotY = 50%)
				(bind backgroundColor "SC.Ui_styles.SERVICE_COLORS.YELLOW")
			)
			(controller $Animation
				(bindcall play
					duration=0.3
					repeatCount=2
					from={alpha:1.0}
					to={alpha:0.0}
					(bind enabled "isSelected") (bind trigger "isSelected")
				)
				(bindcall play
					duration=0.1
					delay=0.6
					to={alpha:1.0}
					(bind enabled "isSelected") (bind trigger "isSelected")
				)
			)
			(bind visible "isSelected")
		)
		(block
			(style
				(width = "WoWSPaint_PALETTE_SIZE - 4px")
				(height = "WoWSPaint_PALETTE_SIZE - 4px")
				(position = "absolute")
				(left = "palettePos")
				(top = "palettePos")
				(pivotX = 50%)
				(pivotY = 50%)
			)
			(block
				(style
					(position = "absolute")
					(width = 100%)
					(height = 100%)
					(bind backgroundColor "colorValue")
				)
				(bind visible "!isEraser")
			)
			(block
				(style
					(position = "absolute")
					(width = 100%)
					(height = 100%)
					(backgroundImage = "'url:../battle_hud/markers/can_hit/icon_cant_hit.png'")
					(backgroundSize = "fill")
				)
				(bind visible "isEraser")
			)
		)
	)

	(dispatch evChangeColor on='click' args="{colorIndex: colorIndex}" dir="EventDirection.UP")
	(macro MOUSE_HANDLER
		_soundSet = "'button_secondary'"
	)
)