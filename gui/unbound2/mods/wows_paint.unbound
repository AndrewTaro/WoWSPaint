# Slot 0 is the eraser and is NOT a pref -- it is a brush MODE (it selects BlendMode.subtract
# downstream), not a colour the user can pick. Slots 1..7 come from wowsPaint.palette.color1..7.
# Detect it by EQUALITY with this sentinel, never by sign: the palette now carries packed
# 0xAARRGGBB values above 2^31, so a `< 0` test would depend on the bridge never handing one
# back signed.
(def constant WoWSPaint_ERASER_COLOR "-1")
(def constant WoWSPaint_PALETTE_COLUMN_COUNT "4")
(def constant WoWSPaint_PALETTE_SIZE "28px")
(def constant WoWSPaint_PALETTE_GAP "3px")
(def constant WoWSPaint_POSITION_KEY 'wowsPaint.position')

(def element WorldOfWarshipsPaint() layout=true
	(scope
		(macro STAGE_SIZE)
		(event evStageMouseMove)
		(event evMouseDown)
		(event evMouseMove)
		(event evMouseUp)
		(event evMouseActive)
		(event evMouseInactive)
		(event evStartDraw)
		(event evStopDraw)
		(event evClearDraw)
		(event evChangeColor)
		(event evClearButtonClick)
		(event evCheckMouseBeforeClear)

		(var mouse:gfx = "$datahub.getSingleComponent(CC.mouse)")
		(var isMouseActive:bool = "mouse.active" (event "mouse.evActiveChanged"))

		(var playerAvatar:gfx = "$datahub.getSingleComponent(CC.playerAvatar)")
		(var isPlayer:bool = "playerAvatar")

		(var isDrawing:bool = "false" watch=false)
		(bind isDrawing "$event.isDrawing" watch=false init=false (event "evStartDraw") (event "evStopDraw"))

		# Palette is built ONCE here and threaded down as _palette -- reading the seven colour prefs
		# in the tile renderer instead would stand up 7 watcher chains per tile across 8 tiles.
		# Reactive on purpose (no watch=false): editing a colour in the config panel repaints live.
		(macro TT_GET_PREF _varName="'color1'" _key="'wowsPaint.palette.color1'")
		(macro TT_GET_PREF _varName="'color2'" _key="'wowsPaint.palette.color2'")
		(macro TT_GET_PREF _varName="'color3'" _key="'wowsPaint.palette.color3'")
		(macro TT_GET_PREF _varName="'color4'" _key="'wowsPaint.palette.color4'")
		(macro TT_GET_PREF _varName="'color5'" _key="'wowsPaint.palette.color5'")
		(macro TT_GET_PREF _varName="'color6'" _key="'wowsPaint.palette.color6'")
		(macro TT_GET_PREF _varName="'color7'" _key="'wowsPaint.palette.color7'")
		(var palette:array = "[
			WoWSPaint_ERASER_COLOR,
			null != color1 && null != color1.value ? color1.value : 0,
			null != color2 && null != color2.value ? color2.value : 0,
			null != color3 && null != color3.value ? color3.value : 0,
			null != color4 && null != color4.value ? color4.value : 0,
			null != color5 && null != color5.value ? color5.value : 0,
			null != color6 && null != color6.value ? color6.value : 0,
			null != color7 && null != color7.value ? color7.value : 0
		]")

		# Runtime state, not a user-facing setting (the schema marks it hidden): seed once from the
		# store, then the click event owns it -- hence watch=false, as in the pre-rewrite view.
		(macro TT_GET_PREF _varName="'brushIndexPref'" _key="'wowsPaint.brushColorIndex'")
		(var brushColorIndex:number = "null != brushIndexPref && null != brushIndexPref.value ? round(brushIndexPref.value) : 0" watch=false)
		(bind brushColorIndex "$event.colorIndex" watch=false init=false (event "evChangeColor"))
		(var brushColor:number = "brushColorIndex < palette.length ? palette[brushColorIndex] : palette[0]")

		(var isEraser:bool = "brushColor == WoWSPaint_ERASER_COLOR")
		(var brushSize:number = "isEraser ? 50 : 3")
	)

	(style
		(bind height "stageHeight")
		(bind width "stageWidth")
	)

	(bindcall externalCall 'direct.action' "['mod.setPref', ['wowsPaint.brushColorIndex', $event.colorIndex]]" init=false watch=false (event "evChangeColor"))

	(dispatch evMouseActive 	watch=false init=false args="{}" (bind enabled "isMouseActive")  (bind trigger "isMouseActive"))
	(dispatch evMouseInactive	watch=false init=false args="{}" (bind enabled "!isMouseActive") (bind trigger "isMouseActive"))
	(dispatch evStartDraw		watch=false init=false dir="EventDirection.DOWN" args="{isDrawing:true, x: $event.x, y: $event.y}" (event "evMouseDown"))
	(dispatch evStopDraw		watch=false init=false dir="EventDirection.DOWN" args="{isDrawing:false}" (event "evMouseUp") (event "evMouseInactive"))
	(dispatch evClearDraw		watch=false init=false dir="EventDirection.DOWN" args="{}" (event "evClearButtonClick"))
	(dispatch evCheckMouseBeforeClear watch=false init=false args="{}" delay=2 (bind enabled "isPlayer") (event "evMouseInactive"))
	(dispatch evClearDraw 		watch=false init=false args="{}" dir="EventDirection.DOWN" (bind enabled "!isMouseActive") (event "evCheckMouseBeforeClear"))

	#canvas
	(block
		(style
			(width = "100%")
	 		(height = "100%")
	 		(position = "absolute")
			#(backgroundColor = 0x00FFFFFF)
			#(hitTest = true)
		)

		#(dispatch evMouseDown args="{x: $event.stageX, y: $event.stageY}" on='mouseDown') #requires hitTest=true and backgroundColor
		(dispatch evMouseDown	watch=false init=false args="{x: $event.stageX, y: $event.stageY}" on='stageMouseDown')
		(dispatch evMouseUp 	watch=false init=false dir="EventDirection.DOWN"  args="{}" on='stageMouseUp')
		# (dispatch evStageMouseMove args="{x: $event.stageX, y: $event.stageY}" on='stageMouseMove')
		# (dispatch evMouseMove dir="EventDirection.DOWN" (bind enabled "isDrawing") (event "evStageMouseMove"))
		(dispatch evMouseMove 	watch=false init=false dir="EventDirection.DOWN" args="$event ? {x: $event.stageX, y: $event.stageY} : null" on='stageMouseMove' (bind enabled "isDrawing"))

		(controller $Repeat renderer='WoWSPaint_LayerElement'
			#(bind count "0" watch=false (event "evClearDraw"))
			# Destroy all the layers so they don't remain.
			# Apparently, addChildAt can handle the element addition without binding count.
			(args
				_currentColor="brushColor"
			)
			(bindcall addChildAt "0" watch=false init=false (event "evStartDraw"))
		)
		(bindcall removeChildren watch=false init=false  (event "evClearDraw"))
		(blendMode = 'layer')
	)
	#controls
	(element WoWSPaint_ControlElement _currentColor="brushColor" _palette="palette")

	# Brush
	# (element WoWSPaint_BrushElement _currentColor="brushColor" _size="brushSize")

	# Experiment: this solves the perf issue?
	(controller $Tooltip (renderer = 'WoWSPaint_BrushElement')
		(args _currentColor="brushColor" _size="brushSize")
		(position="trackMouse")
		(offset=[0,0])
		(screenBoundsOffset={left:-100, top:-100, right:-100, bottom:-100})
		(bindcall show animation={duration:0.15, from:{alpha:0}, to:{alpha:1}} (event "evMouseActive"))
		(bindcall hide animation={duration:0.15, from:{alpha:1}, to:{alpha:0}} (event "evMouseInactive"))
	)
)

(def element WoWSPaint_BrushElement(_currentColor:number, _size:number)
	(scope
		(var isSmall:bool = "_size < 5 ? true : false")
	)

	(style
		(hitTest = false)
	)

	(controller $Sector
		(bind arc "360")
		(bind radius "isSmall ? _size : _size / 2")
		(bind lineColor "_currentColor")
		(bind lineThickness "isSmall ? 2 : 1")
		(bind lineAlpha "isSmall ? 1.0 : 0.4")
	)
	(cacheAsBitmap=true)
)

(def element WoWSPaint_LayerElement(_currentColor:number)
	(scope
		(event evStartDraw)
		(event evClearDraw)
		(event evMouseMove)
		(event evMouseUp)

		(var stage:gfx = "$datahub.getSingleComponent(CC.stage)")
		(var scale:number = "stage.scale" (event "stage.evStageSizeChanged"))

		# Drawing starts as soon as element initialization completes
		# So color and isEraser should not change during that phase.
		(var isEraser:bool = "_currentColor == WoWSPaint_ERASER_COLOR" watch=false)
		(var brushSize:number = "isEraser ? 50 : 3")

		# Layer becomes Active by default when entering the stage.
		# Then it becomes Inactive if the mouse button is up, or drawing ends.
		(var isActiveLayer:bool = "true" watch=false)
		(bind isActiveLayer "false" init=false (event "evMouseUp"))
	)

	(style
		(width = "100%")
		(height = "100%")
		(hitTest = false)
		(position = "absolute")
	)

	(.graphics
		(bindcall lineStyle "brushSize" "_currentColor" watch=false init=false (bind enabled "isActiveLayer") (event "evStartDraw"))
		(bindcall moveTo "round($event.x / scale)" "round($event.y / scale)" watch=false init=false (bind enabled "isActiveLayer") (event "evStartDraw"))
		(bindcall lineTo "round($event.x / scale)" "round($event.y / scale)" watch=false init=false (bind enabled "isActiveLayer") (event "evMouseMove"))
		(bindcall clear watch=false init=false (event "evClearDraw"))
	)
	(blendMode = "isEraser ? 'subtract' : 'layer'")
	# Do not use BlendMode.ERASE since it literally erases everything, including the layers above it.
)

(def element WoWSPaint_ControlElement(_currentColor:number, _palette:array)
	(scope
		(var mouse:gfx = "$datahub.getSingleComponent(CC.mouse)")
		(var isMouseActive:bool = "mouse.active" (event "mouse.evActiveChanged"))

		# Python owns the position value AND the first-placement default (CMS anchor/offset), so the
		# old view-side defaultPos + stageHeight math is gone.
		(macro TT_DRAGGABLE_POSITION _fullKey="WoWSPaint_POSITION_KEY")
		(macro TT_GET_PREF _varName="'lockPref'" _key="'wowsPaint.disableDragdrop'")
		(var isPositionLocked:bool = "null != lockPref && null != lockPref.value ? lockPref.value : false")

		(var camera:gfx = "$datahub.getSingleComponent(CC.camera)")
		(var altVision:bool = "null != camera ? camera.altVision : false" (event "camera.evAltVisionChanged"))

		(event evExpandButtonClick)
		(macro TT_GET_PREF _varName="'paletteModePref'" _key="'wowsPaint.paletteDisplayMode'")
		(var paletteMode:number = "null != paletteModePref && null != paletteModePref.value ? paletteModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")
		(var isPaletteVisible:bool = "paletteMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : paletteMode")
	)

	# The HUD chevron writes the resolved 0/1 -- an explicit click leaves ADAPTIVE rather than
	# toggling within it, which is the only reading that keeps one click = one visible change.
	(bindcall externalCall 'direct.action' "['mod.setPref', ['wowsPaint.paletteDisplayMode', $event.value ? TT_CONST.DISPLAY_MODE.ENABLED : TT_CONST.DISPLAY_MODE.DISABLED]]" init=false watch=false (event "evExpandButtonClick"))

	(style
		(position = "absolute")
		(bind left "dragX")
		(bind top "dragY")
		(alpha = "isMouseActive ? 1.0 : 0.3")
	)

	(controller $Animation
		(bindcall play
			to	="{alpha: 0.3}"
			duration=0.15
			killAll=true
			(bind enabled "!isMouseActive")
			(bind trigger "isMouseActive")
		)
		(bindcall play
			to	="{alpha: 1.0}"
			duration=0.15
			killAll=true
			(bind enabled "isMouseActive")
			(bind trigger "isMouseActive")
		)
	)

	(block
		# Full-size transparent drag surface. MUST stay declared before the content block below --
		# that document order is what keeps TT_DRAGGABLE's signifier behind the controls.
		# hitTest follows the lock: the macro gates the writes and the signifier, but only dropping
		# hitTest here also suppresses the drag-hint tooltip.
		(block
			(class $FullsizeAbsolute)
			# 0x00FFFFFF, not 0x01000000: alpha-0x00 still registers hits, while 0x01000000 renders a
			# visible dark tint over the whole element.
			# hitTest is a STYLE property: bound at element level it resolves against the backing
			# UbSprite and throws "access of undefined method 'hitTest'".  It must sit inside (style).
			(style
				(backgroundColor = 0x00FFFFFF)
				(bind hitTest "!isPositionLocked")
			)
			(macro TT_DRAGGABLE _fullKey="WoWSPaint_POSITION_KEY" _isDragEnabled="!isPositionLocked")
		)
		(block
			(style
				(hitTest = true)
				(align = "middle|center")
				(padding = 10px)
			)

			(hblock
				(style
					(align = "middle|center")
				)
				# expander
				(element WoWSPaint_ExpandButtonElement _isPaletteVisible="isPaletteVisible")

				(tf
					(class $TextDefaultBoldNM)
					(text = "'|'")
					(style
						(hitTest = false)
						(marginRight = 5px)
						(alpha = "0.5")
					)
				)
		
				# reset
				(element WoWSPaint_ResetButtonElement)
			)

			# color palette
			(block
				(controller $Instance renderer='WoWSPaint_ColorPaletteElement'
					(bind enabled "isPaletteVisible")
					(args _currentColor="_currentColor" _palette="_palette")
				)
			)
		)
	)
)

(def element WoWSPaint_ExpandButtonElement(_isPaletteVisible:bool)
	(scope
		(event evExpandButtonClick)
		(macro MOUSE_HANDLER_SCOPE)

		(var isDown:bool = "mouseDown")
		(var isRollover:bool = "rollOver")

		(var ctRollOver:dict = "{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: 15,	greenOffset: 15,	blueOffset: 15,		alphaOffset: 0 }")
		(var ctDown:dict = "	{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: -15,	greenOffset: -15,	blueOffset: -15,	alphaOffset: 0 }")

		# Purely presentational: the host resolves the mode (incl. ADAPTIVE) and owns the write, so the
		# chevron always points at what is actually on screen. Clicking just dispatches the negation UP.
		(var targetRotation:number = "_isPaletteVisible ? 90 : 0")
	)

	(block
		(style
			(width = 18)
			(height = 18)
			(align = "middle|center")
			(marginTop = -2px)
		)
		(block
			(style
				(backgroundSize = "autosize")
				(backgroundImage = "'url:../service_kit/buttons/expand_over.png'")
				(pivotX = 50%)
				(pivotY = 50%)
				(rotation = "targetRotation")
			)
			(controller $Animation
				(bindcall play	duration=0.15	to="{rotation: targetRotation}"	(bind trigger "targetRotation"))
			)
		)

		# Click only. The old addedToStage dispatch seeded the host's local copy of the flag; the host
		# now reads the pref itself, and re-firing on mount would write ADAPTIVE straight back to 0/1.
		(dispatch evExpandButtonClick watch=false init=false dir="EventDirection.UP" args="{value: !_isPaletteVisible}" on='click')

		(macro MOUSE_HANDLER
			_soundSet = "'button_tab'"
		)

		(bind colorTransform "	isRollover && !isDown	? ctRollOver :
								isDown					? ctDown
														: CT_NONE")
	)
)

(def element WoWSPaint_ResetButtonElement()
	(scope
		(event evClearButtonClick)
		(macro MOUSE_HANDLER_SCOPE)

		(var isDown:bool = "mouseDown")
		(var isRollover:bool = "rollOver")

		(var ctRollOver:dict = "{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: 15,	greenOffset: 15,	blueOffset: 15,		alphaOffset: 0 }")
		(var ctDown:dict = "	{ redMultiplier: 1,	greenMultiplier: 1,	blueMultiplier: 1,	alphaMultiplier: 1,
								  redOffset: -15,	greenOffset: -15,	blueOffset: -15,	alphaOffset: 0 }")
	)

	(hblock
		(style
			(align = "middle|center")
		)
		(tf
			(text = "'CLEAR CANVAS'")
			(class $TextDefaultBoldNM)
			(style
				(marginRight = 5px)
				(leading = -6)
			)
		)
		(block
			(style
				(width = 18)
				(height = 18)
				(backgroundImage = "'url:../service_kit/buttons/context/update.png'")
			)
		)

		(bind colorTransform "	isRollover && !isDown	? ctRollOver :
								isDown					? ctDown
														: CT_NONE")

		(dispatch evClearButtonClick on='click' args="{}" dir="EventDirection.UP")
		(macro MOUSE_HANDLER
			_soundSet = "'button_tab'"
		)
	)
)

(def element WoWSPaint_ColorPaletteElement(_currentColor:number, _palette:array)
	(style
		(marginTop = 10px)
		(gap = "WoWSPaint_PALETTE_GAP")
	)
	(controller $Repeat renderer='WoWSPaint_ColorPaletteRowElement' count="ceil(_palette.length / WoWSPaint_PALETTE_COLUMN_COUNT)"
		(args
			_currentColor="_currentColor"
			_palette="_palette"
		)
	)
)

(def element WoWSPaint_ColorPaletteRowElement(_currentColor:number, _palette:array)
	(scope
		(var colorIndexOffset:number = "$index * WoWSPaint_PALETTE_COLUMN_COUNT")
	)

	(style
		(hgap = "WoWSPaint_PALETTE_GAP")
		(flow = "Flow.HORIZONTAL")
	)

	(controller $Repeat renderer='WoWSPaint_ColorTileElement' count="WoWSPaint_PALETTE_COLUMN_COUNT"
		(args
			_index="colorIndexOffset + $index"
			_currentColor="_currentColor"
			_palette="_palette"
		)
	)
)

(def element WoWSPaint_ColorTileElement(_index:number, _currentColor:number, _palette:array)
	(scope
		(event evChangeColor)
		(var colorIndex:number = "_index")
		(var colorValue:number = "_palette[colorIndex]")
		(var isValidColor:number = "colorIndex < _palette.length")
		(var isSelected:bool = "colorValue == _currentColor")

		(var isEraser:bool = "colorValue == WoWSPaint_ERASER_COLOR")

		(var palettePos:number = "WoWSPaint_PALETTE_SIZE / 2")

		(macro MOUSE_HANDLER_SCOPE)
	)

	(bind visible "isValidColor")
	
	(block
		(style
			(width  = "WoWSPaint_PALETTE_SIZE")
			(height = "WoWSPaint_PALETTE_SIZE")
		)
		(block
			(style
				(position = "absolute")
				(width = 100%)
				(height = 100%)
				(left = "palettePos")
				(top = "palettePos")
				(pivotX = 50%)
				(pivotY = 50%)
				(bind backgroundColor "SC.Ui_styles.SERVICE_COLORS.YELLOW")
			)
			(controller $Animation
				(bindcall play
					duration=0.3
					repeatCount=2
					from={alpha:1.0}
					to={alpha:0.0}
					(bind enabled "isSelected") (bind trigger "isSelected")
				)
				(bindcall play
					duration=0.1
					delay=0.6
					to={alpha:1.0}
					(bind enabled "isSelected") (bind trigger "isSelected")
				)
			)
			(bind visible "isSelected")
		)
		(block
			(style
				(width = "WoWSPaint_PALETTE_SIZE - 4px")
				(height = "WoWSPaint_PALETTE_SIZE - 4px")
				(position = "absolute")
				(left = "palettePos")
				(top = "palettePos")
				(pivotX = 50%)
				(pivotY = 50%)
			)
			(block
				(style
					(position = "absolute")
					(width = 100%)
					(height = 100%)
					(bind backgroundColor "colorValue")
				)
				(bind visible "!isEraser")
			)
			(block
				(style
					(position = "absolute")
					(width = 100%)
					(height = 100%)
					(backgroundImage = "'url:../battle_hud/markers/can_hit/icon_cant_hit.png'")
					(backgroundSize = "fill")
				)
				(bind visible "isEraser")
			)
		)
	)

	(dispatch evChangeColor on='click' args="{colorIndex: colorIndex}" dir="EventDirection.UP")
	(macro MOUSE_HANDLER
		_soundSet = "'button_secondary'"
	)
)